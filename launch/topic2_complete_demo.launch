<launch>
    <!-- Запуск симуляции -->
    <include file="$(find turtlebot3_gazebo)/launch/turtlebot3_world.launch" />
    
    <!-- Публикация TF из модели робота -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
        <param name="publish_frequency" type="double" value="50.0" />
    </node>
    
    <!-- Дополнительный статический TF -->
    <node pkg="tf" type="static_transform_publisher" name="base_to_laser" 
          args="0 0 0.3 0 0 0 base_footprint base_scan 100" />
    
    <!-- Запуск Rviz с конфигурацией -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find my_ros_topics)/rviz/lidar_tf.rviz"/>
</launch>
