<launch>
    <arg name="rviz" default="false" />

    <!-- Запуск симуляции с управлением Rviz -->
    <include file="$(find my_ros_topics)/launch/topic4_sim_controlled.launch">
        <arg name="rviz" value="false" />
    </include>
    
    <!-- Запуск gmapping -->
    <include file="$(find my_ros_topics)/launch/topic4_gmapping_basic.launch" />

    <!-- Запуск Rviz с конфигом для картографирования -->
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find my_ros_topics)/rviz/sim_mapping.rviz" />    
</launch>
